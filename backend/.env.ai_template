# MedAI Environment Configuration

# ============================================================================
# EXISTING SETTINGS (Keep these)
# ============================================================================
DEBUG=true
RAG_MAX_SOURCES=8
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=8

# ============================================================================
# NEW: ML Model Settings (XGBoost)
# ============================================================================
ML_MODEL_TYPE=xgboost
XGBOOST_N_ESTIMATORS=200
XGBOOST_MAX_DEPTH=7
XGBOOST_LEARNING_RATE=0.1

# ============================================================================
# NEW: Ollama Settings (Local LLM - Optional)
# ============================================================================
# Set to true to enable local LLM explanations
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=30

# ============================================================================
# NEW: Vector DB Settings (Chroma)
# ============================================================================
# Auto-initialized on first run, no setup needed
CHROMA_DB_PATH=./data/chroma
CHROMA_COLLECTION_NAME=medical_data

# ============================================================================
# NEW: Explanation Settings (LIME/SHAP)
# ============================================================================
# Enable LIME explanations in diagnosis responses
LIME_ENABLED=true
# Number of samples for LIME explanation (higher = more accurate but slower)
LIME_NUM_SAMPLES=1000

# ============================================================================
# NOTES:
# ============================================================================
# 1. Ollama Setup (if you want local LLM):
#    - Download from: https://ollama.ai/
#    - Run: ollama serve
#    - Pull model: ollama pull mistral
#    - Then set OLLAMA_ENABLED=true
#
# 2. Vector DB:
#    - Auto-initializes with medical data on first diagnosis
#    - Can manually rebuild: POST /api/admin/vector-db/index
#    - Data stored in: backend/data/chroma/
#
# 3. XGBoost:
#    - Default settings optimized for medical diagnosis
#    - Adjust XGBOOST_N_ESTIMATORS if overfitting/underfitting
#    - Higher MAX_DEPTH = more complex patterns but slower
#
# 4. Troubleshooting:
#    - Slow LIME: reduce LIME_NUM_SAMPLES to 500
#    - Ollama slow: ensure ollama serve is running
#    - Vector DB issues: delete backend/data/chroma/ and rebuild
