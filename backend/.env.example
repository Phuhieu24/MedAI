DEBUG=true

# RAG always uses the local SQLite knowledge base. LLM is optional.
RAG_MAX_SOURCES=8
# LLM_TRAINING_DIR defaults to backend/data/llm_training
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=8
